# Example only: blank credentials cannot connect. Fill only your ignored local env file.
# Use a fresh, owner-approved test credential; never copy one from Git history.
# Copy the Session pooler connection string from Supabase > Connect.
# Percent-encode special characters in the database password.
DATABASE_URL=
DATABASE_SSL=true
# Optional path to the CA certificate downloaded from Supabase
DATABASE_CA_FILE=
PORT=4000
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Set BOTH NODE_ENV=test and ALLOW_TEST_RESET=true only on an isolated test DB.
ALLOW_TEST_RESET=false
TEST_RESET_KEY=replace-with-a-long-random-secret
SEED_PASSWORD=
