{
  "name": "coffee-cart-api", "private": true, "version": "1.0.0", "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "build": "tsc", "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env src/db/manage.ts migrate",
    "db:seed": "tsx --env-file=.env src/db/manage.ts seed",
    "test:domain": "vitest run tests/domain.test.ts",
    "test:http": "vitest run tests/http.test.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts"
  },
  "dependencies": {"express": "5.1.0", "cors": "2.8.5", "pg": "8.16.3"},
  "devDependencies": {"@types/express": "5.0.3", "@types/cors": "2.8.19", "@types/pg": "8.15.5", "@types/node": "22.18.6", "tsx": "4.20.6", "typescript": "5.9.2", "vitest": "3.2.4"}
}
