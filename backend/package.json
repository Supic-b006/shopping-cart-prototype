{
  "name": "coffee-cart-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env src/db/manage.ts migrate",
    "db:seed": "tsx --env-file=.env src/db/manage.ts seed",
    "test:domain": "vitest run tests/domain.test.ts",
    "test:http": "vitest run tests/http.test.ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:team": "vitest run tests/cartService.test.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "typecheck:unit": "tsc --noEmit -p tsconfig.unit.json"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "5.1.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "^5.1.0"
  }
}
