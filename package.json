{
  "name": "coffee-cart-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "db:migrate": "node scripts/test-runtime.mjs migrate",
    "db:seed": "node scripts/test-runtime.mjs seed",
    "test": "npm run test:unit && npm run test:unit:team",
    "test:domain": "npm run test:domain -w backend",
    "test:http": "node scripts/test-runtime.mjs http",
    "db:migrate:e2e": "node scripts/test-runtime.mjs migrate",
    "db:seed:e2e": "node scripts/test-runtime.mjs seed",
    "test:integration": "node scripts/test-runtime.mjs integration",
    "test:unit": "npm run test:unit -w backend --",
    "test:unit:team": "npm run test:unit:team -w backend --",
    "test:coverage": "npm run test:coverage -w backend",
    "typecheck:unit": "npm run typecheck:unit -w backend",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "node scripts/test-runtime.mjs e2e",
    "test:env:init": "node scripts/test-runtime.mjs init",
    "test:env": "node scripts/test-runtime.mjs check",
    "test:browsers": "node scripts/test-runtime.mjs browsers",
    "test:infrastructure": "node --test scripts/test-environment.test.mjs",
    "test:all": "npm test && npm run typecheck && npm run typecheck:unit && npm run typecheck:e2e && npm run build && npm run test:integration && npm run test:http && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/ui": "5.1.0",
    "concurrently": "9.2.5",
    "dotenv": "^18.0.9",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
