{
  "name": "coffee-cart-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "test": "npm test -w backend",
    "test:domain": "npm run test:domain -w backend",
    "test:http": "npm run test:http -w backend",
    "db:migrate:e2e": "node --env-file=.env.e2e --import tsx backend/src/db/manage.ts migrate",
    "db:seed:e2e": "node --env-file=.env.e2e --import tsx backend/src/db/manage.ts seed",
    "test:integration": "npm run test:integration -w backend",
    "test:unit": "npm run test:unit -w backend",
    "test:unit:team": "npm run test:unit:team -w backend",
    "test:coverage": "npm run test:coverage -w backend",
    "typecheck:unit": "npm run typecheck:unit -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/ui": "5.1.0",
    "concurrently": "9.2.5",
    "dotenv": "^18.0.9",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
