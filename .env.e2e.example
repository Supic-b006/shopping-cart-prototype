# Configure only with NEW credentials supplied by the test database owner.
# Never copy credentials from backend/.env.example or Git history.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_CA_FILE=

# Independent target confirmation: hostname only, and decoded database name.
TEST_DATABASE_HOST=
TEST_DATABASE_PORT=
TEST_DATABASE_NAME=
TEST_DATABASE_USER=
TEST_DATABASE_CONFIRMED=false

SEED_PASSWORD=
TEST_RESET_KEY=
NODE_ENV=test
RUN_DB_TESTS=false
ALLOW_TEST_RESET=false
E2E_ALLOW_RESET=false

PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
VITE_API_ORIGIN=
E2E_EXTERNAL_SERVERS=false
E2E_SLOWMO=0
E2E_CHROMIUM_PATH=
